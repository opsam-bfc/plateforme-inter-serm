# Template de configuration des secrets Streamlit.
# Sur Streamlit Community Cloud : coller ces valeurs dans
#   Settings > Secrets (onglet TOML)
# En local : copier ce fichier en `.streamlit/secrets.toml` (ne pas committer).

# ── Mot de passe d'acces a la plateforme ─────────────────────────────────────
# Hash SHA-256 du mot de passe choisi. Pour le generer :
#   python -c "import hashlib; print(hashlib.sha256(b'VOTRE_MOT_DE_PASSE').hexdigest())"
# Laisser vide ("") pour desactiver la protection (mode developpement).
MOT_DE_PASSE_HASH = ""

# ── Token Mapbox (optionnel) ──────────────────────────────────────────────────
# Si fourni : fond de carte Carto Positron (plus esthétique).
# Sinon : OpenStreetMap (gratuit, sans token).
# Compte gratuit sur https://account.mapbox.com/
MAPBOX_TOKEN = ""
